<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Tasks - Todo App</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f5f5f5; color: #111; }
    header {
      background: #6366f1;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .75rem 1.5rem;
    }
    header h1 { font-size: 1.25rem; }
    .btn-logout {
      background: transparent;
      border: 1px solid rgba(255,255,255,.6);
      border-radius: 4px;
      color: #fff;
      cursor: pointer;
      font-size: .875rem;
      padding: .35rem .75rem;
    }
    .btn-logout:hover { background: rgba(255,255,255,.15); }
    main { max-width: 680px; margin: 2rem auto; padding: 0 1rem; }
    .error {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      border-radius: 4px;
      color: #b91c1c;
      font-size: .875rem;
      margin-bottom: 1rem;
      padding: .6rem .8rem;
    }
    .add-form {
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 1px 4px rgba(0,0,0,.1);
      padding: 1.25rem;
      margin-bottom: 2rem;
    }
    .add-form h2 { font-size: 1rem; margin-bottom: .75rem; }
    input[type="text"], textarea {
      border: 1px solid #d1d5db;
      border-radius: 4px;
      font-size: .95rem;
      padding: .45rem .7rem;
      width: 100%;
    }
    input:focus, textarea:focus { border-color: #6366f1; outline: 2px solid #c7d2fe; }
    textarea { resize: vertical; min-height: 60px; }
    .field { margin-bottom: .75rem; }
    label { display: block; font-size: .8rem; font-weight: 600; margin-bottom: .2rem; }
    .btn-primary {
      background: #6366f1;
      border: none;
      border-radius: 4px;
      color: #fff;
      cursor: pointer;
      font-size: .9rem;
      padding: .45rem 1rem;
    }
    .btn-primary:hover { background: #4f46e5; }
    section { margin-bottom: 2rem; }
    section h2 { font-size: 1.1rem; margin-bottom: .75rem; border-bottom: 2px solid #e5e7eb; padding-bottom: .4rem; }
    .empty-state {
      color: #6b7280;
      font-size: .9rem;
      padding: 1rem 0;
      text-align: center;
    }
    .task-card {
      background: #fff;
      border-radius: 6px;
      box-shadow: 0 1px 3px rgba(0,0,0,.08);
      margin-bottom: .75rem;
      padding: .9rem 1rem;
    }
    .task-card.completed .task-title { text-decoration: line-through; color: #9ca3af; }
    .task-title { font-weight: 600; margin-bottom: .2rem; }
    .task-desc { color: #6b7280; font-size: .85rem; margin-bottom: .6rem; }
    .task-actions { display: flex; gap: .5rem; flex-wrap: wrap; }
    .btn-sm {
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: .8rem;
      padding: .3rem .65rem;
    }
    .btn-toggle { background: #d1fae5; color: #065f46; }
    .btn-toggle:hover { background: #a7f3d0; }
    .btn-edit { background: #dbeafe; color: #1e40af; }
    .btn-edit:hover { background: #bfdbfe; }
    .btn-delete { background: #fee2e2; color: #991b1b; }
    .btn-delete:hover { background: #fecaca; }
    .edit-form { margin-top: .75rem; display: none; }
    .edit-form.open { display: block; }
    .edit-form .field { margin-bottom: .5rem; }
    .edit-actions { display: flex; gap: .5rem; }
    .btn-save { background: #6366f1; color: #fff; }
    .btn-save:hover { background: #4f46e5; }
    .btn-cancel { background: #e5e7eb; color: #374151; }
    .btn-cancel:hover { background: #d1d5db; }
  </style>
</head>
<body>
  <header>
    <h1>My Tasks</h1>
    <form method="POST" action="/auth/logout">
      <button type="submit" class="btn-logout">Log out</button>
    </form>
  </header>

  <main>

    <% if (error) { %>
      <div class="error" role="alert"><%= error %></div>
    <% } %>

    <!-- Add task form -->
    <div class="add-form">
      <h2>Add a new task</h2>
      <form method="POST" action="/tasks">
        <div class="field">
          <label for="title">Title <span aria-hidden="true">*</span></label>
          <input type="text" id="title" name="title" placeholder="What needs to be done?" required />
        </div>
        <div class="field">
          <label for="description">Description (optional)</label>
          <textarea id="description" name="description" placeholder="Add details..."></textarea>
        </div>
        <button type="submit" class="btn-primary">Add task</button>
      </form>
    </div>

    <!-- Pending tasks section -->
    <section id="pending-section">
      <h2>Pending (<%= pending.length %>)</h2>
      <% if (pending.length === 0) { %>
        <p class="empty-state">No pending tasks. Add one above!</p>
      <% } else { %>
        <% pending.forEach(function(task) { %>
          <div class="task-card" id="task-<%= task.id %>">
            <div class="task-title"><%= task.title %></div>
            <% if (task.description) { %>
              <div class="task-desc"><%= task.description %></div>
            <% } %>
            <div class="task-actions">
              <button type="button" class="btn-sm btn-toggle" onclick="toggleStatus(<%= task.id %>, 'pending')">Mark complete</button>
              <button type="button" class="btn-sm btn-edit" onclick="toggleEdit(<%= task.id %>)">Edit</button>
              <form method="POST" action="/tasks/<%= task.id %>/delete" onsubmit="return confirm('Delete this task?')">
                <button type="submit" class="btn-sm btn-delete">Delete</button>
              </form>
            </div>
            <!-- Inline edit form -->
            <div class="edit-form" id="edit-<%= task.id %>">
              <form method="POST" action="/tasks/<%= task.id %>/edit">
                <div class="field">
                  <label for="edit-title-<%= task.id %>">Title</label>
                  <input type="text" id="edit-title-<%= task.id %>" name="title" value="<%= task.title %>" required />
                </div>
                <div class="field">
                  <label for="edit-desc-<%= task.id %>">Description</label>
                  <textarea id="edit-desc-<%= task.id %>" name="description"><%= task.description %></textarea>
                </div>
                <div class="edit-actions">
                  <button type="submit" class="btn-sm btn-save">Save</button>
                  <button type="button" class="btn-sm btn-cancel" onclick="toggleEdit(<%= task.id %>)">Cancel</button>
                </div>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </section>

    <!-- Completed tasks section -->
    <section id="completed-section">
      <h2>Completed (<%= completed.length %>)</h2>
      <% if (completed.length === 0) { %>
        <p class="empty-state">No completed tasks yet.</p>
      <% } else { %>
        <% completed.forEach(function(task) { %>
          <div class="task-card completed" id="task-<%= task.id %>">
            <div class="task-title"><%= task.title %></div>
            <% if (task.description) { %>
              <div class="task-desc"><%= task.description %></div>
            <% } %>
            <div class="task-actions">
              <button type="button" class="btn-sm btn-toggle" onclick="toggleStatus(<%= task.id %>, 'completed')">Mark pending</button>
              <button type="button" class="btn-sm btn-edit" onclick="toggleEdit(<%= task.id %>)">Edit</button>
              <form method="POST" action="/tasks/<%= task.id %>/delete" onsubmit="return confirm('Delete this task?')">
                <button type="submit" class="btn-sm btn-delete">Delete</button>
              </form>
            </div>
            <!-- Inline edit form -->
            <div class="edit-form" id="edit-<%= task.id %>">
              <form method="POST" action="/tasks/<%= task.id %>/edit">
                <div class="field">
                  <label for="edit-title-<%= task.id %>">Title</label>
                  <input type="text" id="edit-title-<%= task.id %>" name="title" value="<%= task.title %>" required />
                </div>
                <div class="field">
                  <label for="edit-desc-<%= task.id %>">Description</label>
                  <textarea id="edit-desc-<%= task.id %>" name="description"><%= task.description %></textarea>
                </div>
                <div class="edit-actions">
                  <button type="submit" class="btn-sm btn-save">Save</button>
                  <button type="button" class="btn-sm btn-cancel" onclick="toggleEdit(<%= task.id %>)">Cancel</button>
                </div>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </section>

    <!-- Global empty state: shown when user has no tasks at all -->
    <% if (pending.length === 0 && completed.length === 0) { %>
      <p class="empty-state" style="margin-top:-1rem;">You have no tasks yet. Add your first task above!</p>
    <% } %>
  </main>

  <script>
    function toggleEdit(id) {
      var form = document.getElementById('edit-' + id);
      form.classList.toggle('open');
    }

    function updateSectionHeading(sectionId, delta) {
      var section = document.getElementById(sectionId);
      var h2 = section.querySelector('h2');
      var match = h2.textContent.match(/^(\w+)\s*\((\d+)\)/);
      if (match) {
        var label = match[1];
        var count = parseInt(match[2], 10) + delta;
        h2.textContent = label + ' (' + count + ')';
      }
    }

    function updateEmptyState(sectionId) {
      var section = document.getElementById(sectionId);
      var cards = section.querySelectorAll('.task-card');
      var empty = section.querySelector('.empty-state');
      if (cards.length === 0) {
        if (!empty) {
          var p = document.createElement('p');
          p.className = 'empty-state';
          p.textContent = sectionId === 'pending-section'
            ? 'No pending tasks. Add one above!'
            : 'No completed tasks yet.';
          section.appendChild(p);
        }
      } else {
        if (empty) empty.remove();
      }
    }

    function toggleStatus(id, currentStatus) {
      fetch('/tasks/' + id + '/toggle', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(function(res) {
          if (!res.ok) { window.location.reload(); return; }
          var card = document.getElementById('task-' + id);
          if (!card) return;

          var isCompleted = currentStatus === 'pending'; // after toggle, pending → completed
          var fromSection = isCompleted ? 'pending-section' : 'completed-section';
          var toSection   = isCompleted ? 'completed-section' : 'pending-section';
          var newLabel    = isCompleted ? 'Mark pending' : 'Mark complete';
          var newStatus   = isCompleted ? 'completed' : 'pending';

          // Update toggle button
          var btn = card.querySelector('.btn-toggle');
          btn.textContent = newLabel;
          btn.setAttribute('onclick', 'toggleStatus(' + id + ', \'' + newStatus + '\')');

          // Update card style
          if (isCompleted) {
            card.classList.add('completed');
          } else {
            card.classList.remove('completed');
          }

          // Move card
          document.getElementById(toSection).appendChild(card);

          // Update counts
          updateSectionHeading(fromSection, -1);
          updateSectionHeading(toSection, +1);

          // Update empty states
          updateEmptyState(fromSection);
          updateEmptyState(toSection);
        })
        .catch(function() { window.location.reload(); });
    }
  </script>
</body>
</html>
