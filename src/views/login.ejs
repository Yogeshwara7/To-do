<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login - Todo App</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, sans-serif;
      background: #f5f5f5;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    .card {
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,.12);
      padding: 2rem;
      width: 100%;
      max-width: 360px;
    }
    h1 { font-size: 1.5rem; margin-bottom: 1.5rem; text-align: center; }
    .error {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      border-radius: 4px;
      color: #b91c1c;
      font-size: .875rem;
      margin-bottom: 1rem;
      padding: .6rem .8rem;
    }
    label { display: block; font-size: .875rem; font-weight: 600; margin-bottom: .25rem; }
    input[type="text"], input[type="password"] {
      border: 1px solid #d1d5db;
      border-radius: 4px;
      font-size: 1rem;
      padding: .5rem .75rem;
      width: 100%;
    }
    input:focus { border-color: #6366f1; outline: 2px solid #c7d2fe; }
    .field { margin-bottom: 1rem; }
    button[type="submit"] {
      background: #6366f1;
      border: none;
      border-radius: 4px;
      color: #fff;
      cursor: pointer;
      font-size: 1rem;
      padding: .6rem;
      width: 100%;
    }
    button[type="submit"]:hover { background: #4f46e5; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Todo App</h1>

    <% if (error) { %>
      <div class="error" role="alert"><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/login" novalidate>
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" autocomplete="username" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required />
      </div>
      <button type="submit">Log in</button>
    </form>

    <p style="margin-top:1rem;text-align:center;font-size:.875rem;color:#6b7280;">
      No account? <a href="/auth/register" style="color:#6366f1;text-decoration:none;">Create one</a>
    </p>
  </div>
</body>
</html>
